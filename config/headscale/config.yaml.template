# Minimal Headscale configuration
# server_url and dns.base_domain are overridden at runtime via HEADSCALE_* env vars in docker compose,
# but must be present here so headplane can validate the config file.

server_url: https://headscale.__HOST_NAME__

listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090
grpc_listen_addr: 0.0.0.0:50443

grpc_allow_insecure: true
disable_check_updates: true

unix_socket: /var/run/headscale/headscale.sock
unix_socket_permission: "0770"

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential

derp:
  server:
    enabled: true
    region_id: 999
    region_code: headscale
    region_name: pi-pcloud Embedded DERP
    stun_listen_addr: 0.0.0.0:3478
    # Stated though it is already the default: this relay answers the whole
    # internet, so the value restricting it to enrolled nodes should be readable
    # here rather than resting on a default surviving a bump. Do not check it
    # with `tailscale debug derp` - that probes with a throwaway key and only
    # calls Connect(), so it reports success against a relay correctly refusing
    # it. docs/TROUBLESHOOTING.md has the test that works.
    verify_clients: true
    # No ipv4/ipv6 on purpose: headscale copies them into the DERP map it serves
    # every client and they must be public addresses. This used to say
    # `ipv4: headscale`, a container name, so the relay was advertised and never
    # once usable. Omitting both leaves the HostName alone, which clients
    # resolve through ddns-updater's record and so survives a WAN address change
    # where a literal would not. docs/TROUBLESHOOTING.md#vpn.
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  update_frequency: 24h

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
    write_ahead_log: true

log:
  level: info
  format: text

policy:
  mode: file
  path: /etc/headscale/policy.hujson

dns:
  magic_dns: true
  override_local_dns: true
  nameservers:
    global:
      - 100.64.0.1
    split:
      __HOST_NAME__:
        - 100.64.0.1


oidc:
  issuer: https://auth.__HOST_NAME__
  client_id: headscale
  client_secret: __OIDC_HEADSCALE_SECRET__
  # Headscale resolves the OIDC provider once, at startup, and picks its auth
  # provider from the result. Left false, a discovery call that fails at that
  # instant is a single WRN line and headscale keeps serving with the *CLI*
  # provider: /register/<id> then renders the "run headscale nodes register"
  # page instead of redirecting to Authelia, which is all a TV's QR code has to
  # go on. Nothing else breaks, so the stack looks healthy for weeks.
  # True turns that into a refusal to start, and restart: unless-stopped retries
  # until Authelia answers. The compose service pins auth.<HOST_NAME> to Traefik
  # so this only ever waits on Authelia, never on public DNS or NAT hairpinning.
  only_start_if_oidc_is_available: true

logtail:
  enabled: false

taildrop:
  enabled: true
