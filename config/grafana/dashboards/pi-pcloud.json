{
  "uid": "pi-pcloud-overview",
  "title": "pi-pcloud",
  "description": "The whole stack in four rows. Provisioned from config/grafana/dashboards/pi-pcloud.json with allowUiUpdates: false, so a browser edit can be tried but never saved — Grafana refuses it outright. Change the file.",
  "tags": ["pi-pcloud"],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "LLM gateway",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 101,
      "title": "LLM spend, selected range",
      "description": "Empty unless agentgateway has a cost catalog: config.modelCatalog is unset here, so every lookup resolves NoCatalog and no cost series is produced. The local model is free; only the Groq and OpenRouter routes would ever bill. See docs/MONITORING.md.",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "no model catalog configured",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(agentgateway_gen_ai_client_cost_usd_total[$__range]))",
          "instant": true,
          "legendFormat": "spend"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 102,
      "title": "Tokens per second, by model and caller",
      "description": "The `user` label comes from config.metrics.fields in config/agentgateway/config.yaml and names the API key that made the call: open-webui, trilium or agent. Cache reads are excluded so the two halves sum to real work.",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8,
            "axisLabel": "tokens/s"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum by (gen_ai_request_model, user) (rate(agentgateway_gen_ai_client_token_usage_sum{gen_ai_token_type=~\"input|output\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}} · {{user}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 103,
      "title": "Time to first token, p95",
      "description": "Streaming requests only — agentgateway records no TTFT for a non-streamed completion, so a quiet graph here with traffic on the panels beside it means the callers are not streaming.",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (gen_ai_request_model, le) (rate(agentgateway_gen_ai_server_time_to_first_token_bucket[$__rate_interval])))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 104,
      "title": "LLM request duration, p95",
      "description": "Whole request, from the gateway accepting it to the last token. On the local model this tracks prompt length far more than anything else.",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (gen_ai_request_model, le) (rate(agentgateway_gen_ai_server_request_duration_bucket[$__rate_interval])))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ]
    },

    {
      "type": "row",
      "id": 200,
      "title": "Traefik",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 201,
      "title": "Requests per second, by router",
      "description": "Router labels are off in Traefik by default; --metrics.prometheus.addRoutersLabels in compose.yaml is what makes this per-site rather than per-entrypoint.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["mean", "max"],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum by (router) (rate(traefik_router_requests_total[$__rate_interval]))",
          "legendFormat": "{{router}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 202,
      "title": "Share of requests answered 4xx / 5xx",
      "description": "A share, not a count, so it does not just track traffic. 4xx is mostly the lan allowlist and Authelia refusing a request; a sustained 5xx is a backend that is up but broken — the failure Uptime Kuma's container monitors cannot see.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "4xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "5xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(traefik_router_requests_total{code=~\"4..\"}[$__rate_interval])) / sum(rate(traefik_router_requests_total[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(traefik_router_requests_total{code=~\"5..\"}[$__rate_interval])) / sum(rate(traefik_router_requests_total[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 203,
      "title": "Router latency, p95",
      "description": "Measured at Traefik, so it includes the forward-auth hop to Authelia on the routers that carry it.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["max"],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (router, le) (rate(traefik_router_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{router}}"
        }
      ]
    },

    {
      "type": "row",
      "id": 300,
      "title": "Authentication",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 301,
      "title": "Authelia authentication attempts",
      "description": "Counts per graph interval rather than a per-second rate: on a household stack these are a handful of events a day, and a rate would round them to a flat zero. Individual failures are already pushed to the ntfy `security` topic by scripts/authelia-ntfy-watch.sh; this is the shape over time that a push cannot show.",
      "interval": "5m",
      "gridPos": { "h": 7, "w": 16, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "succeeded" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(authelia_authn{success=\"true\"}[$__interval]))",
          "legendFormat": "succeeded"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(authelia_authn{success=\"false\"}[$__interval]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "type": "stat",
      "id": 302,
      "title": "Attempts refused while banned, selected range",
      "description": "Attempts refused because Authelia had already banned the account or the source address — regulation.modes is ['user','ip'], so either can be the cause. It counts refused *attempts*, not bans: one ban that a client keeps retrying against adds one here per retry, so read it as pressure rather than as a number of bans. Any non-zero value here has a matching push on the ntfy `security` topic.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(authelia_authn{banned=\"true\"}[$__range]))",
          "instant": true,
          "legendFormat": "bans"
        }
      ]
    },

    {
      "type": "row",
      "id": 400,
      "title": "Services",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 401,
      "title": "n8n workflow executions",
      "description": "Per graph interval. Workflow and node identity are deliberately absent: N8N_METRICS_INCLUDE_* are all left off, because /metrics is served on n8n's routed port and workflow names would then be readable by anything past the lan allowlist.",
      "interval": "5m",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(n8n_workflow_execution_duration_seconds_count[$__interval]))",
          "legendFormat": "executions"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 402,
      "title": "Immich job queues in flight",
      "description": "Immich puts the queue name in the metric *name*, not in a label (immich.queues.<queue>.active), so the series are matched by __name__ and the queue is recovered with label_replace. A queue that stays high for hours is the usual cause of the Pi feeling slow after an import.",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "pointSize": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "label_replace({__name__=~\"immich_queues_.+_active\"}, \"queue\", \"$1\", \"__name__\", \"immich_queues_(.+)_active\")",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 403,
      "title": "Headscale nodes",
      "description": "Registered devices in the tailnet, from headscale's own metrics listener — enabled in config/headscale/config.yaml long before this dashboard existed.",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "headscale_nodestore_nodes",
          "legendFormat": "nodes"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 404,
      "title": "ntfy messages published",
      "description": "Per graph interval, across all topics — ntfy counts publications without a topic label. Every alert in the stack lands here, so a flat line while something is visibly broken means the delivery channel itself is the fault.",
      "interval": "5m",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "published" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(ntfy_messages_published_success[$__interval]))",
          "legendFormat": "published"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "pi-prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(ntfy_messages_published_failure[$__interval]))",
          "legendFormat": "failed"
        }
      ]
    }
  ]
}
