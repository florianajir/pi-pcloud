server:
  address: 'tcp://0.0.0.0:9091'

log:
  level: info

theme: auto

telemetry:
  metrics:
    enabled: true
    # Spelled out rather than left to the default (which is this value): it is a
    # second listener on a port compose has to `expose` for Prometheus to reach,
    # and the two would drift silently if only one of them named the number.
    # Separate from server.address above, so /metrics is never served on the
    # port Traefik routes - auth.__HOST_NAME__/metrics stays a 404.
    address: 'tcp://0.0.0.0:9959'

webauthn:
  disable: false
  enable_passkey_login: true
  display_name: 'pi-pcloud'

totp:
  issuer: __HOST_NAME__

identity_validation:
  reset_password:
    jwt_secret: '{{ secret "/config/secrets/jwt_secret" }}'

authentication_backend:
  ldap:
    implementation: lldap
    address: ldap://lldap:3890
    # The default 5s bind timeout is shorter than an I/O stall on a swapping host,
    # and a bind that times out mid-refresh-grant surfaces to the client as a 500.
    # Pooling keeps warm connections so a stall costs a retry, not a dead session.
    timeout: '15s'
    pooling:
      enable: true
      count: 5
      retries: 2
      timeout: '10s'
    base_dn: dc=home,dc=ldap
    additional_users_dn: ou=people
    users_filter: (&(|({username_attribute}={input})(mail={input}))(objectClass=person))
    additional_groups_dn: ou=groups
    # The `lldap_*` groups are LLDAP's own permission model (write access to the
    # directory, read-only browsing, password resets) - not application roles. Left
    # unfiltered they travel in the `groups` claim to every client that asks for the
    # scope, which is how Nextcloud ended up with provisioned `lldap_admin` and
    # `lldap_strict_readonly` groups, and is the same class of problem that forced
    # the `groups` scope off Audiobookshelf. LLDAP 0.6 supports `!` and a `cn`
    # substring here, so one filter keeps the claim to groups that mean something.
    groups_filter: (&(member={dn})(!(cn=lldap_*)))
    attributes:
      group_name: cn
      mail: mail
      display_name: displayName
      username: uid
    user: uid=admin,ou=people,dc=home,dc=ldap
    password: '{{ secret "/config/secrets/ldap_password" }}'

access_control:
  default_policy: deny
  rules:
    - domain: 'auth.__HOST_NAME__'
      policy: bypass

    - domain:
        - 'uptime.__HOST_NAME__'
        - 'homepage.__HOST_NAME__'
        - 'qbittorrent.__HOST_NAME__'
        - 'prowlarr.__HOST_NAME__'
        - 'kapowarr.__HOST_NAME__'
        - 'ai.__HOST_NAME__'
      policy: one_factor

    - domain: 'headscale.__HOST_NAME__'
      resources:
        - '^/admin(/.*)?$'
      subject:
        - 'group:admin'
      policy: two_factor

    # Nothing follows this rule for these domains, and nothing should: rules are
    # first-match, and a `subject` the user does not satisfy is not a match - so a
    # bare `two_factor` rule for `lldap.__HOST_NAME__` sitting below this one (which
    # is what shipped until the OIDC group audit) lets every account into the
    # directory UI and makes the admin gate above decorative. Users who need to
    # change their own password use LLDAP's reset mail, enabled on the container
    # through LLDAP_SMTP_OPTIONS__ENABLE_PASSWORD_RESET.
    - domain:
        - 'backrest.__HOST_NAME__'
        - 'pihole.__HOST_NAME__'
        - 'traefik.__HOST_NAME__'
        - 'lldap.__HOST_NAME__'
        - 'grafana.__HOST_NAME__'
      subject:
        - 'group:admin'
      policy: two_factor

session:
  name: authelia_session
  same_site: lax
  inactivity: '45m'
  expiration: '12h'
  remember_me: '1M'
  secret: '{{ secret "/config/secrets/session_secret" }}'
  cookies:
    - domain: '__HOST_NAME__'
      authelia_url: 'https://auth.__HOST_NAME__'
  redis:
    host: redis
    port: 6379
    database_index: 1
    password: '{{ secret "/config/secrets/redis_password" }}'

regulation:
  # Ban the source IP as well as the account. IP mode is only meaningful now that
  # Traefik declares no forwardedHeaders.trustedIPs and the forward-auth call runs
  # with trustForwardHeader=false: while the client's own X-Forwarded-For was
  # trusted, the address Authelia regulated on was attacker-chosen, so a per-IP ban
  # was evaded by changing a header. With `user` alone, spraying many usernames
  # from one address locks each account for 5 minutes and never slows the caller.
  modes: ['user', 'ip']
  max_retries: 3
  find_time: '2m'
  ban_time: '5m'

storage:
  encryption_key: '{{ secret "/config/secrets/storage_encryption_key" }}'
  postgres:
    address: 'tcp://postgres:5432'
    database: authelia
    username: authelia
    password: '{{ secret "/config/secrets/db_password" }}'

identity_providers:
  oidc:
    hmac_secret: '{{ secret "/config/secrets/oidc_hmac_secret" }}'
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
__OIDC_PRIVATE_KEY__
    lifespans:
      access_token: '1h'
      authorize_code: '1m'
      id_token: '1h'
      refresh_token: '90d'
    authorization_policies:
      admin_only:
        default_policy: 'deny'
        rules:
          - policy: 'two_factor'
            subject: 'group:admin'
    enable_client_debug_messages: false
    cors:
      endpoints:
        - authorization
        - token
        - revocation
        - introspection
      allowed_origins:
        - 'https://nextcloud.__HOST_NAME__'
        - 'https://immich.__HOST_NAME__'
        - 'https://beszel.__HOST_NAME__'
        - 'https://dockhand.__HOST_NAME__'
        - 'https://headscale.__HOST_NAME__'
        - 'https://ai.__HOST_NAME__'
        - 'https://vault.__HOST_NAME__'
    clients:
      - client_id: nextcloud
        client_name: Nextcloud
        client_secret: '{{ secret "/config/secrets/oidc_nextcloud_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://nextcloud.__HOST_NAME__/index.php/apps/user_oidc/code'
          - 'https://nextcloud.__HOST_NAME__/apps/user_oidc/code'
        scopes:
          - openid
          - profile
          - email
          - groups
          - offline_access
        response_types:
          - code
        response_modes:
          - form_post
          - query
        grant_types:
          - authorization_code
          - refresh_token
        token_endpoint_auth_method: client_secret_post
        userinfo_signed_response_alg: none

      - client_id: immich
        client_name: Immich
        client_secret: '{{ secret "/config/secrets/oidc_immich_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://immich.__HOST_NAME__/auth/login'
          - 'https://immich.__HOST_NAME__/user-settings'
          - 'app.immich:///oauth-callback'
        # `groups` feeds Immich's own role claim, pointed at `groups` in
        # config/immich/oauth-config.yaml.template: it treats the claim as a list
        # and looks for the literal values `admin` and `user`, so the LLDAP `admin`
        # group promotes and demotes on every login with no custom claim to mint.
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        id_token_signed_response_alg: RS256
        userinfo_signed_response_alg: none
        token_endpoint_auth_method: client_secret_post

      - client_id: beszel
        client_name: Beszel
        client_secret: '{{ secret "/config/secrets/oidc_beszel_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris:
          - 'https://beszel.__HOST_NAME__/api/oauth2-redirect'
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: dockhand
        client_name: Dockhand
        client_secret: '{{ secret "/config/secrets/oidc_dockhand_secret_hash" }}'
        public: false
        authorization_policy: admin_only
        consent_mode: implicit
        redirect_uris:
          - 'https://dockhand.__HOST_NAME__/api/auth/oidc/callback'
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_post
        userinfo_signed_response_alg: none

      - client_id: headplane
        client_name: Headplane
        client_secret: '{{ secret "/config/secrets/oidc_headplane_secret_hash" }}'
        public: false
        authorization_policy: admin_only
        consent_mode: implicit
        redirect_uris:
          - 'https://headscale.__HOST_NAME__/admin/oidc/callback'
        scopes:
          - openid
          - profile
          - email
          - offline_access
        response_types:
          - code
        grant_types:
          - authorization_code
          - refresh_token
        token_endpoint_auth_method: client_secret_basic

      - client_id: headscale
        client_name: Headscale
        client_secret: '{{ secret "/config/secrets/oidc_headscale_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://headscale.__HOST_NAME__/oidc/callback'
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: open-webui
        client_name: Open WebUI
        client_secret: '{{ secret "/config/secrets/oidc_open-webui_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://ai.__HOST_NAME__/oauth/oidc/callback'
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: agentgateway
        client_name: Agentgateway
        client_secret: '{{ secret "/config/secrets/oidc_agentgateway_secret_hash" }}'
        public: false
        authorization_policy: admin_only
        consent_mode: implicit
        redirect_uris:
          - 'https://llm.__HOST_NAME__/oauth/callback'
        # Agentgateway's browser flow always sends a code challenge.
        require_pkce: true
        pkce_challenge_method: 'S256'
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        # It takes client_secret_basic from discovery when offered, which
        # Authelia does; crates/agentgateway/src/http/oauth.rs.
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: vaultwarden
        client_name: Vaultwarden
        client_secret: '{{ secret "/config/secrets/oidc_vaultwarden_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        # Vaultwarden derives this callback from its own DOMAIN setting; it is not
        # configurable, so it must match https://vault.__HOST_NAME__ exactly.
        redirect_uris:
          - 'https://vault.__HOST_NAME__/identity/connect/oidc-signin'
        scopes:
          - openid
          - profile
          - email
          - offline_access
        response_types:
          - code
        grant_types:
          - authorization_code
          - refresh_token
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: shelfmark
        client_name: Shelfmark
        client_secret: '{{ secret "/config/secrets/oidc_shelfmark_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://shelfmark.__HOST_NAME__/api/auth/oidc/callback'
        require_pkce: true
        pkce_challenge_method: 'S256'
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: kavita
        client_name: Kavita
        client_secret: '{{ secret "/config/secrets/oidc_kavita_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://kavita.__HOST_NAME__/signin-oidc'
        # No `groups`: Kavita's role sync is off (see scripts/kavita-oidc-bootstrap.sh
        # for why), so the claim would be received and ignored. This scope and Kavita's
        # `CustomScopes` have to move together - Kavita appends CustomScopes to the
        # authorization request without checking `scopes_supported`, so a scope set on
        # one side only means `invalid_scope` and, with password login disabled, nobody
        # can reach Kavita at all.
        scopes:
          - openid
          - profile
          - email
          - offline_access
        response_types:
          - code
        grant_types:
          - authorization_code
          - refresh_token
        token_endpoint_auth_method: client_secret_post
        userinfo_signed_response_alg: none

      - client_id: audiobookshelf
        client_name: Audiobookshelf
        client_secret: '{{ secret "/config/secrets/oidc_audiobookshelf_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://audiobooks.__HOST_NAME__/auth/openid/callback'
          # The mobile apps do not receive the code themselves: Audiobookshelf
          # takes the callback here and bounces it to audiobookshelf://oauth,
          # so this URL - not the custom scheme - is what Authelia must allow.
          - 'https://audiobooks.__HOST_NAME__/auth/openid/mobile-redirect'
        require_pkce: true
        pkce_challenge_method: 'S256'
        # No `groups`: Audiobookshelf reads the group claim as a role and denies
        # any login whose groups contain none of admin/user/guest. Only `admin`
        # exists in this stack (see docs/SECURITY.md), so asking for the claim
        # would lock out every regular user. Roles are set in the app instead.
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        # openid-client, which Audiobookshelf uses, sets no
        # token_endpoint_auth_method and so defaults to basic.
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: freshrss
        client_name: FreshRSS
        client_secret: '{{ secret "/config/secrets/oidc_freshrss_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        # mod_auth_openidc's own callback path, fixed by the image's
        # FreshRSS.Apache.conf (OIDCRedirectURI /i/oidc/) - not configurable
        # through an environment variable, so it has to match exactly.
        redirect_uris:
          - 'https://rss.__HOST_NAME__/i/oidc/'
        # The image's FreshRSS.Apache.conf sets no OIDCPKCEMethod, but
        # mod_auth_openidc defaults to S256 anyway - the authorization request it
        # builds does carry a code_challenge (verified against the running
        # container), so requiring it costs nothing. Drop this if a future image
        # ever pins OIDCPKCEMethod to none.
        require_pkce: true
        pkce_challenge_method: 'S256'
        # No `groups`: FreshRSS derives no roles from the token - the admin is
        # the account created by FRESHRSS_USER, everyone else is auto-registered
        # as a plain user. This policy is what decides who gets in at all.
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: trilium
        client_name: Trilium Notes
        client_secret: '{{ secret "/config/secrets/oidc_trilium_secret_hash" }}'
        public: false
        # one_factor, not admin_only, because Authelia is not the last gate here:
        # Trilium binds the first `sub` that enrolls and refuses every other one
        # afterwards (`wrong_account`), so a second account passing this policy
        # still cannot sign in. See docs/SECURITY.md for the enrollment step.
        authorization_policy: one_factor
        consent_mode: implicit
        # Fixed by OIDC_ROUTES in apps/server/src/services/open_id.ts and not
        # exposed as a setting - only the host part moves, via oauthBaseUrl.
        redirect_uris:
          - 'https://notes.__HOST_NAME__/callback'
        # Authelia's own Trilium guide says `require_pkce: false`, and reading
        # Trilium's source agrees - it fills authorizationParams with
        # response_type and scope only. Both are misleading: the challenge is
        # added a layer down, by the bundled express-openid-connect, which does
        # `if (response_type.includes("code"))` and then always sets
        # code_challenge_method=S256. Verified in the v0.105.0 main.cjs bundle,
        # which also carries the library's own "the authorization request will
        # use PKCE" debug string. `false` would merely stop requiring what is
        # sent anyway; requiring it matches every other client here.
        require_pkce: true
        pkce_challenge_method: 'S256'
        # No `groups`: Trilium has no roles at all. The identity it enrolls is
        # the owner of the whole instance, and there is exactly one.
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        # Trilium leaves oauthClientAuthMethod empty and auto-detects: its
        # resolveClientAuthMethod() returns client_secret_basic for any issuer
        # not on its incompatibility list, which Authelia is not.
        token_endpoint_auth_method: client_secret_basic
        # Must stay `none`: enrollment calls fetchUserInfo() to get the name and
        # email that the ID token does not carry under the code flow, and
        # express-openid-connect parses that response as plain JSON.
        userinfo_signed_response_alg: none

      - client_id: grafana
        client_name: Grafana
        client_secret: '{{ secret "/config/secrets/oidc_grafana_secret_hash" }}'
        public: false
        # admin_only, matching the access_control rule above and Dockhand's
        # stance: the dashboards carry per-caller LLM spend and Authelia's own
        # failure counts, which is admin data rather than household data.
        authorization_policy: admin_only
        consent_mode: implicit
        # Fixed by Grafana: /login/<provider id>, and the generic provider's id
        # is `generic_oauth` whatever GF_AUTH_GENERIC_OAUTH_NAME says.
        redirect_uris:
          - 'https://grafana.__HOST_NAME__/login/generic_oauth'
        # GF_AUTH_GENERIC_OAUTH_USE_PKCE=true in compose.yaml.
        require_pkce: true
        pkce_challenge_method: 'S256'
        # `groups` is read, unlike most clients here: Grafana's
        # role_attribute_path maps the `admin` group onto its Admin org role and
        # everyone else onto Viewer.
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        # No offline_access: GF_AUTH_GENERIC_OAUTH_USE_REFRESH_TOKEN is false, so
        # a refresh token would only be a credential nothing spends - and
        # requesting the scope would re-introduce the consent prompt Kavita hit.
        #
        # basic, not post, and not cosmetic: Grafana's generic provider is
        # golang.org/x/oauth2 at AuthStyleAutoDetect, which tries the header
        # (basic) first and only falls back to form parameters after a failure.
        # Declaring `post` here would therefore make every first token exchange
        # 400 before succeeding on the retry - and scripts/authelia-ntfy-watch.sh
        # publishes exactly that rejection to the `security` topic.
        token_endpoint_auth_method: client_secret_basic
        # Must stay `none`: Grafana reads the groups claim from UserInfo (the ID
        # token under the code flow does not carry it) and parses that response
        # as plain JSON.
        userinfo_signed_response_alg: none

      - client_id: homepage
        client_name: Homepage
        client_secret: '{{ secret "/config/secrets/oidc_homepage_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        # Fixed by NextAuth: provider id `homepage-oidc`, path built from
        # HOMEPAGE_EXTERNAL_URL. Not configurable on the client side.
        redirect_uris:
          - 'https://homepage.__HOST_NAME__/api/auth/callback/homepage-oidc'
        # [...nextauth].js declares checks: pkce, state, nonce.
        require_pkce: true
        pkce_challenge_method: 'S256'
        # No `groups`: homepage has no roles - every signed-in account sees the
        # same dashboard, so this policy is the whole access decision. It matches
        # the `homepage.__HOST_NAME__` access_control rule above.
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        # next-auth v4 leaves openid-client at its default, basic.
        token_endpoint_auth_method: client_secret_basic
        # Unused rather than wrong: `idToken: true` means next-auth builds its
        # profile from the ID Token and never calls UserInfo, so homepage sees no
        # `email` or `name` - both UserInfo-only here. It needs neither, and so
        # needs no `claims_policy`: all it reads off the session is that there is
        # one, to draw the sign-out button.
        userinfo_signed_response_alg: none

notifier:
  disable_startup_check: true
  smtp:
    address: 'submission://{{ env "SMTP_HOST" }}:{{ env "SMTP_PORT" }}'
    username: '{{ env "SMTP_USERNAME" }}'
    password: '{{ env "SMTP_PASSWORD" }}'
    sender: '{{ env "EMAIL" }}'
    identifier: 'auth.__HOST_NAME__'
    disable_require_tls: false
    disable_starttls: false
