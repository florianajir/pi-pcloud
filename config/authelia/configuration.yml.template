server:
  address: 'tcp://0.0.0.0:9091'

log:
  level: info

theme: auto

telemetry:
  metrics:
    enabled: false

webauthn:
  disable: false
  enable_passkey_login: true
  display_name: 'pi-pcloud'

totp:
  issuer: __HOST_NAME__

identity_validation:
  reset_password:
    jwt_secret: '{{ secret "/config/secrets/jwt_secret" }}'

authentication_backend:
  ldap:
    implementation: lldap
    address: ldap://lldap:3890
    # The default 5s bind timeout is shorter than an I/O stall on a swapping host,
    # and a bind that times out mid-refresh-grant surfaces to the client as a 500.
    # Pooling keeps warm connections so a stall costs a retry, not a dead session.
    timeout: '15s'
    pooling:
      enable: true
      count: 5
      retries: 2
      timeout: '10s'
    base_dn: dc=home,dc=ldap
    additional_users_dn: ou=people
    users_filter: (&(|({username_attribute}={input})(mail={input}))(objectClass=person))
    additional_groups_dn: ou=groups
    # The `lldap_*` groups are LLDAP's own permission model (write access to the
    # directory, read-only browsing, password resets) - not application roles. Left
    # unfiltered they travel in the `groups` claim to every client that asks for the
    # scope, which is how Nextcloud ended up with provisioned `lldap_admin` and
    # `lldap_strict_readonly` groups, and is the same class of problem that forced
    # the `groups` scope off Audiobookshelf. LLDAP 0.6 supports `!` and a `cn`
    # substring here, so one filter keeps the claim to groups that mean something.
    groups_filter: (&(member={dn})(!(cn=lldap_*)))
    attributes:
      group_name: cn
      mail: mail
      display_name: displayName
      username: uid
    user: uid=admin,ou=people,dc=home,dc=ldap
    password: '{{ secret "/config/secrets/ldap_password" }}'

access_control:
  default_policy: deny
  rules:
    - domain: 'auth.__HOST_NAME__'
      policy: bypass

    - domain:
        - 'uptime.__HOST_NAME__'
        - 'homepage.__HOST_NAME__'
        - 'qbittorrent.__HOST_NAME__'
        - 'prowlarr.__HOST_NAME__'
        - 'kapowarr.__HOST_NAME__'
        - 'ai.__HOST_NAME__'
      policy: one_factor

    - domain: 'headscale.__HOST_NAME__'
      resources:
        - '^/admin(/.*)?$'
      subject:
        - 'group:admin'
      policy: two_factor

    # Nothing follows this rule for these domains, and nothing should: rules are
    # first-match, and a `subject` the user does not satisfy is not a match - so a
    # bare `two_factor` rule for `lldap.__HOST_NAME__` sitting below this one (which
    # is what shipped until the OIDC group audit) lets every account into the
    # directory UI and makes the admin gate above decorative. Users who need to
    # change their own password use LLDAP's reset mail, enabled on the container
    # through LLDAP_SMTP_OPTIONS__ENABLE_PASSWORD_RESET.
    - domain:
        - 'backrest.__HOST_NAME__'
        - 'pihole.__HOST_NAME__'
        - 'traefik.__HOST_NAME__'
        - 'lldap.__HOST_NAME__'
      subject:
        - 'group:admin'
      policy: two_factor

session:
  name: authelia_session
  same_site: lax
  inactivity: '45m'
  expiration: '12h'
  remember_me: '1M'
  secret: '{{ secret "/config/secrets/session_secret" }}'
  cookies:
    - domain: '__HOST_NAME__'
      authelia_url: 'https://auth.__HOST_NAME__'
  redis:
    host: redis
    port: 6379
    database_index: 1
    password: '{{ secret "/config/secrets/redis_password" }}'

regulation:
  # Ban the source IP as well as the account. IP mode is only meaningful now that
  # Traefik declares no forwardedHeaders.trustedIPs and the forward-auth call runs
  # with trustForwardHeader=false: while the client's own X-Forwarded-For was
  # trusted, the address Authelia regulated on was attacker-chosen, so a per-IP ban
  # was evaded by changing a header. With `user` alone, spraying many usernames
  # from one address locks each account for 5 minutes and never slows the caller.
  modes: ['user', 'ip']
  max_retries: 3
  find_time: '2m'
  ban_time: '5m'

storage:
  encryption_key: '{{ secret "/config/secrets/storage_encryption_key" }}'
  postgres:
    address: 'tcp://postgres:5432'
    database: authelia
    username: authelia
    password: '{{ secret "/config/secrets/db_password" }}'

identity_providers:
  oidc:
    hmac_secret: '{{ secret "/config/secrets/oidc_hmac_secret" }}'
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
__OIDC_PRIVATE_KEY__
    lifespans:
      access_token: '1h'
      authorize_code: '1m'
      id_token: '1h'
      refresh_token: '90d'
    authorization_policies:
      admin_only:
        default_policy: 'deny'
        rules:
          - policy: 'two_factor'
            subject: 'group:admin'
    enable_client_debug_messages: false
    cors:
      endpoints:
        - authorization
        - token
        - revocation
        - introspection
      allowed_origins:
        - 'https://nextcloud.__HOST_NAME__'
        - 'https://immich.__HOST_NAME__'
        - 'https://beszel.__HOST_NAME__'
        - 'https://dockhand.__HOST_NAME__'
        - 'https://headscale.__HOST_NAME__'
        - 'https://ai.__HOST_NAME__'
        - 'https://vault.__HOST_NAME__'
    clients:
      - client_id: nextcloud
        client_name: Nextcloud
        client_secret: '{{ secret "/config/secrets/oidc_nextcloud_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://nextcloud.__HOST_NAME__/index.php/apps/user_oidc/code'
          - 'https://nextcloud.__HOST_NAME__/apps/user_oidc/code'
        scopes:
          - openid
          - profile
          - email
          - groups
          - offline_access
        response_types:
          - code
        response_modes:
          - form_post
          - query
        grant_types:
          - authorization_code
          - refresh_token
        token_endpoint_auth_method: client_secret_post
        userinfo_signed_response_alg: none

      - client_id: immich
        client_name: Immich
        client_secret: '{{ secret "/config/secrets/oidc_immich_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://immich.__HOST_NAME__/auth/login'
          - 'https://immich.__HOST_NAME__/user-settings'
          - 'app.immich:///oauth-callback'
        # `groups` feeds Immich's own role claim, pointed at `groups` in
        # config/immich/oauth-config.yaml.template: it treats the claim as a list
        # and looks for the literal values `admin` and `user`, so the LLDAP `admin`
        # group promotes and demotes on every login with no custom claim to mint.
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        id_token_signed_response_alg: RS256
        userinfo_signed_response_alg: none
        token_endpoint_auth_method: client_secret_post

      - client_id: beszel
        client_name: Beszel
        client_secret: '{{ secret "/config/secrets/oidc_beszel_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris:
          - 'https://beszel.__HOST_NAME__/api/oauth2-redirect'
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: dockhand
        client_name: Dockhand
        client_secret: '{{ secret "/config/secrets/oidc_dockhand_secret_hash" }}'
        public: false
        authorization_policy: admin_only
        consent_mode: implicit
        redirect_uris:
          - 'https://dockhand.__HOST_NAME__/api/auth/oidc/callback'
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_post
        userinfo_signed_response_alg: none

      - client_id: headplane
        client_name: Headplane
        client_secret: '{{ secret "/config/secrets/oidc_headplane_secret_hash" }}'
        public: false
        authorization_policy: admin_only
        consent_mode: implicit
        redirect_uris:
          - 'https://headscale.__HOST_NAME__/admin/oidc/callback'
        scopes:
          - openid
          - profile
          - email
          - offline_access
        response_types:
          - code
        grant_types:
          - authorization_code
          - refresh_token
        token_endpoint_auth_method: client_secret_basic

      - client_id: headscale
        client_name: Headscale
        client_secret: '{{ secret "/config/secrets/oidc_headscale_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://headscale.__HOST_NAME__/oidc/callback'
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: open-webui
        client_name: Open WebUI
        client_secret: '{{ secret "/config/secrets/oidc_open-webui_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://ai.__HOST_NAME__/oauth/oidc/callback'
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: agentgateway
        client_name: Agentgateway
        client_secret: '{{ secret "/config/secrets/oidc_agentgateway_secret_hash" }}'
        public: false
        authorization_policy: admin_only
        consent_mode: implicit
        redirect_uris:
          - 'https://llm.__HOST_NAME__/oauth/callback'
        # Agentgateway's browser flow always sends a code challenge.
        require_pkce: true
        pkce_challenge_method: 'S256'
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        # It takes client_secret_basic from discovery when offered, which
        # Authelia does; crates/agentgateway/src/http/oauth.rs.
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: vaultwarden
        client_name: Vaultwarden
        client_secret: '{{ secret "/config/secrets/oidc_vaultwarden_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        # Vaultwarden derives this callback from its own DOMAIN setting; it is not
        # configurable, so it must match https://vault.__HOST_NAME__ exactly.
        redirect_uris:
          - 'https://vault.__HOST_NAME__/identity/connect/oidc-signin'
        scopes:
          - openid
          - profile
          - email
          - offline_access
        response_types:
          - code
        grant_types:
          - authorization_code
          - refresh_token
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: shelfmark
        client_name: Shelfmark
        client_secret: '{{ secret "/config/secrets/oidc_shelfmark_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://shelfmark.__HOST_NAME__/api/auth/oidc/callback'
        require_pkce: true
        pkce_challenge_method: 'S256'
        scopes:
          - openid
          - profile
          - email
          - groups
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

      - client_id: kavita
        client_name: Kavita
        client_secret: '{{ secret "/config/secrets/oidc_kavita_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://kavita.__HOST_NAME__/signin-oidc'
        # No `groups`: Kavita's role sync is off (see scripts/kavita-oidc-bootstrap.sh
        # for why), so the claim would be received and ignored. This scope and Kavita's
        # `CustomScopes` have to move together - Kavita appends CustomScopes to the
        # authorization request without checking `scopes_supported`, so a scope set on
        # one side only means `invalid_scope` and, with password login disabled, nobody
        # can reach Kavita at all.
        scopes:
          - openid
          - profile
          - email
          - offline_access
        response_types:
          - code
        grant_types:
          - authorization_code
          - refresh_token
        token_endpoint_auth_method: client_secret_post
        userinfo_signed_response_alg: none

      - client_id: audiobookshelf
        client_name: Audiobookshelf
        client_secret: '{{ secret "/config/secrets/oidc_audiobookshelf_secret_hash" }}'
        public: false
        authorization_policy: one_factor
        consent_mode: implicit
        redirect_uris:
          - 'https://audiobooks.__HOST_NAME__/auth/openid/callback'
          # The mobile apps do not receive the code themselves: Audiobookshelf
          # takes the callback here and bounces it to audiobookshelf://oauth,
          # so this URL - not the custom scheme - is what Authelia must allow.
          - 'https://audiobooks.__HOST_NAME__/auth/openid/mobile-redirect'
        require_pkce: true
        pkce_challenge_method: 'S256'
        # No `groups`: Audiobookshelf reads the group claim as a role and denies
        # any login whose groups contain none of admin/user/guest. Only `admin`
        # exists in this stack (see docs/SECURITY.md), so asking for the claim
        # would lock out every regular user. Roles are set in the app instead.
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        # openid-client, which Audiobookshelf uses, sets no
        # token_endpoint_auth_method and so defaults to basic.
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none

notifier:
  disable_startup_check: true
  smtp:
    address: 'submission://{{ env "SMTP_HOST" }}:{{ env "SMTP_PORT" }}'
    username: '{{ env "SMTP_USERNAME" }}'
    password: '{{ env "SMTP_PASSWORD" }}'
    sender: '{{ env "EMAIL" }}'
    identifier: 'auth.__HOST_NAME__'
    disable_require_tls: false
    disable_starttls: false
