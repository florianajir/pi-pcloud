oauth:
  enabled: true
  issuerUrl: 'https://auth.__HOST_NAME__'
  clientId: 'immich'
  clientSecret: '__OIDC_IMMICH_SECRET__'
  autoRegister: true
  autoLaunch: true
  buttonText: 'Login'
  scope: 'openid profile email groups'
  signingAlgorithm: 'RS256'
  profileSigningAlgorithm: 'none'
  tokenEndpointAuthMethod: 'client_secret_post'
  storageLabelClaim: 'preferred_username'
  # Immich reads this claim as a list and looks for the literal strings `admin` or
  # `user`, so pointing it straight at `groups` makes the LLDAP `admin` group the
  # source of truth - re-evaluated on every login, so it promotes *and* demotes,
  # unlike the storage claims which only apply at account creation. No custom
  # Authelia claim is needed. An account in neither yields no role at all, which
  # Immich reads as "leave alone": a family member never gets demoted by accident.
  roleClaim: 'groups'
  # Authelia's portal logout route, not an end_session_endpoint - see
  # docs/SECURITY.md. Keep autoLaunch=0 percent-encoded: decoded, its `?` falls
  # out of `rd`, and without it the login page bounces back to Authelia.
  endSessionEndpoint: 'https://auth.__HOST_NAME__/logout?rd=https%3A%2F%2Fimmich.__HOST_NAME__%2Fauth%2Flogin%3FautoLaunch%3D0'
# A sibling of `oauth`, not a key inside it - Immich's schema puts them side by
# side and nesting this is ignored silently. Off so the shared .env PASSWORD is
# not a way past Authelia; Immich refuses to let the UI override a config file,
# so the way back in is to flip this and restart.
passwordLogin:
  enabled: false
