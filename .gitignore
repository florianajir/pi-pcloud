# Bytecode from importing the Python scripts (test harnesses, py_compile);
# a plain run never writes it, since __main__ is not cached.
__pycache__/
*.pyc

._.DS_Store
.DS_Store

# Agent scratch space: ignored on this machine through .git/info/exclude and a
# global ignore, which do not travel with the repository - on a fresh clone a
# `git add -A` would commit both.
/.claude/settings.local.json
/.claude/worktrees/
/.ruff_cache/
