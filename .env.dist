# --- Personal Configuration ---
HOST_NAME=
TIMEZONE=
# Language for anything the stack has to pick a language for, as a BCP 47 tag:
# the Open WebUI interface, and which Piper voice reads answers aloud. Defaults
# to en-US; fr-FR is the other one with voices shipped. Any other tag falls back
# rather than failing, and needs a voice added to config/piper/Dockerfile to be
# read aloud properly.
DEFAULT_LANGUAGE=
ADMIN_USER=
PASSWORD=

# --- EMAIL ---
EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=


# --- Data root for bind-mounted services ---
DATA_LOCATION=./data

# --- Host swap size in MB, applied by `make install` ---
# Raspberry Pi OS ships 2048 MB and dphys-swapfile refuses to exceed its own
# CONF_MAXSWAP=2048 default, so `make install` raises both. The model services
# (parakeet, llama-cpp, immich-machine-learning) load weights, go idle and have
# their cold pages evicted once, which is what swap is for - but they filled a
# 4096 MB file to 99.99% between them, leaving nothing for the next spike. The
# per-service ceilings in compose.yaml (`memswap_limit`) are sized against this
# number. Leave empty to keep the default of 8192.
SWAP_SIZE_MB=8192

# --- Services ---
# Services to enable (comma-separated Docker Compose profiles; one profile per
# optional service, named after it). "all" enables everything. Some services
# auto-start their dependencies: qbittorrent/stremio/kapowarr pull in gluetun,
# n8n-runners pulls in n8n, beszel-agent pulls in beszel, prowlarr pulls in
# flaresolverr. Shelfmark bundles its own browser, so it needs none; it uses
# gluetun's HTTP proxy for direct downloads when gluetun is enabled, but runs
# without it. Core infrastructure (traefik, authelia, pihole, headscale,
# postgres, ...) always runs.
# Example: COMPOSE_PROFILES=immich-server,nextcloud,stremio,open-webui,llama-cpp
COMPOSE_PROFILES=all

# --- Network Configuration ---
HOST_LAN_IP=
HOST_LAN_PARENT=eth0
HOST_LAN_SUBNET=192.168.1.0/24
HOST_LAN_GATEWAY=192.168.1.1
# Pi-hole IP address on the LAN
PIHOLE_IP=192.168.1.250
# Only used by the `stremio-lan` profile: Stremio's own LAN address, needed so it
# can discover cast renderers. Free, in the subnet, outside the DHCP range.
STREMIO_IP=192.168.1.251
# Loopback, the LAN, the tailnet, the Docker networks - then the same for IPv6,
# minus the LAN (HOST_LAN_SUBNET6 below owns that) and minus the Docker networks:
# only traefik has an IPv6 address, and it never calls itself, so the sole source
# that could appear from fd00:30:15::/64 is the bridge gateway - which is exactly
# what docker-proxy substitutes when the IPv6 DNAT is missing. Allowlisting it
# would turn that failure into an open door instead of a 403.
ALLOW_IP_RANGES=127.0.0.1/32,192.168.1.0/24,100.64.0.0/10,172.30.0.0/16,::1/128,fd7a:115c:a1e0::/48
# The IPv6 prefix your ISP delegates to the LAN (e.g. 2001:db8:1:200::/64),
# appended to ALLOW_IP_RANGES. No fixed default is possible - it is not yours to
# choose and it changes when the line reconnects - so wan-allowlist-sync.sh
# (systemd timer) reads it off HOST_LAN_PARENT and keeps it current. Leave it to
# the timer. It admits what 192.168.1.0/24 admits: every device on your LAN.
HOST_LAN_SUBNET6=
# Publishes AAAA records for <HOST_NAME> and *.<HOST_NAME>, making the stack
# reachable from the internet over IPv6. Use 1; any non-empty value enables it,
# including 0 and false, because Compose can only test for emptiness.
#
# Set it *after* allowing inbound 443/tcp (and 443/udp for HTTP/3) to the Pi in
# your router's IPv6 firewall - a firewall rule, not a port forward, since IPv6
# has no NAT. Publish first and off-LAN clients try IPv6 and fail. Empty leaves
# public DNS as A records only, IPv6 still working from the LAN.
IPV6_PUBLIC_RECORDS=
# Appended to ALLOW_IP_RANGES for the `lan` middleware. Leave it empty unless
# your router hairpins: when a LAN client resolves a stack hostname through the
# router rather than Pi-hole, it gets the public address, and the router loops
# that connection back inside with the source rewritten to its own WAN address -
# which the allowlist refuses, so every gated service answers a bare 403. One
# entry (`<wan-ip>/32`) fixes it for every device and every resolver at once,
# and admits nothing new *as long as the address is yours alone*: only a
# connection that left the LAN is hairpinned, so a request from the internet
# arrives with its own source. On a CGNAT line the address is shared with other
# subscribers and must not be allowlisted - wan-allowlist-sync.sh refuses those.
# It expires with the line's address, so that script (systemd timer, installed by
# `make install`) keeps it current. Set it once and let the timer own it.
#
# IPv4 only: with no NAT, an IPv6 client reaches the Pi's global address over
# the local link and is never hairpinned.
WAN_HAIRPIN_IP=
# Pi-hole upstream DNS servers, semicolon-separated. dnsmasq load-balances across
# all of them rather than treating the first as primary, so the public resolvers
# see a share of normal traffic - a deliberate trade, see compose.yaml's pihole
# service. Leave only the Unbound entry if you want no third party to see any query.
PIHOLE_DNS_UPSTREAMS=172.30.53.53#5335;1.1.1.1;9.9.9.9

# --- Traefik ---
# Cloudflare API token with DNS edit permissions for your zone.
CLOUDFLARE_DNS_API_TOKEN=
# Cloudflare Zone ID for your domain (find in Cloudflare dashboard)
CLOUDFLARE_ZONE_ID=

# --- Nextcloud ---
# ISO country code assumed for phone numbers entered without a prefix.
NEXTCLOUD_DEFAULT_PHONE_REGION=FR
# Number of SQL dump files to keep in data/nextcloud-config/backups. Read by
# Backrest, which takes the dump; unset, compose.yaml falls back to 30.
NEXTCLOUD_SQL_BACKUP_KEEP=7
# UTC hour at which Nextcloud runs its heavy background jobs.
NEXTCLOUD_MAINTENANCE_WINDOW_START=2

# --- S3 Storage (shared credentials) ---
# Used by Backrest (restic) and Beszel (PocketBase).
# Leave empty to skip S3 auto-configuration.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Backrest (restic S3 backup) ---
# URI is auto-derived as s3:${S3_ENDPOINT}/${S3_BUCKET}/restic
# Set BACKREST_S3_URI explicitly only if you need a custom path.
BACKREST_S3_REPO_PASSWORD=
# Second, local repository holding only the .env history, on DATA_LOCATION.
# Leave this empty: backrest-pre-start.sh generates a password into
# ${DATA_LOCATION}/backrest/repos/env-repo-password so that disk can restore
# .env on its own. Setting it here means the value you would need to read the
# repository lives inside the file the repository exists to give back.
BACKREST_LOCAL_REPO_PASSWORD=

# --- Beszel (PocketBase built-in backups) ---
BESZEL_S3_FORCE_PATH_STYLE=true
BESZEL_BACKUP_CRON=0 3 * * *
BESZEL_BACKUP_MAX_KEEP=7

# --- Shelfmark (audiobook metadata) ---
# Hardcover personal access token, free from https://hardcover.app/account/api
# (starts with hc_pat_). Optional, and only Shelfmark reads it: without it
# audiobook searches fall back to Open Library, a *book* catalogue that carries
# almost no audio edition data. Set it and scripts/shelfmark-settings-bootstrap.sh
# enables Hardcover and makes it the default audiobook provider.
HARDCOVER_API_KEY=
