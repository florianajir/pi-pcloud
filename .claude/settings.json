{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.bak*)",
      "Read(./.env.tmp*)",
      "Read(./.rotate-password.*)",
      "Read(./config/**/*.env)",
      "Read(./config/**/*.env.bak.*)",
      "Read(./config/homepage/secrets/**)",
      "Read(./config/backrest/config.json)",
      "Read(./config/backrest/config.json.bak.*)",
      "Read(./config/headscale/config.yaml)",
      "Read(./config/headplane/config.yaml)",
      "Read(./config/headplane/headscale_api_key)",
      "Read(./config/gluetun/openvpn.ovpn)",
      "Read(./data/**)",
      "Read(//mnt/usbdrive/**)",
      "Edit(./.env)",
      "Edit(./config/**/*.env)",
      "Edit(./config/homepage/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/no-secret-reads.sh\"",
            "timeout": 10,
            "statusMessage": "Vetting command for secret exposure"
          }
        ]
      }
    ]
  }
}
