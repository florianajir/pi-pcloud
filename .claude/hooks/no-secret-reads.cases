# Cases for no-secret-reads.test.sh. Format: <deny|allow> TAB <command>
# \n in a command becomes a newline, so heredocs can be expressed on one line.
#
# These are not invented: the deny cases are the actual leaks and near-misses
# from the session that prompted the hook, and the allow cases are the
# legitimate commands it must not break.

# --- the leaks that happened ---
deny	docker exec pi-kavita sh -c 'cat /config/appsettings.json'
deny	docker exec pi-kavita sh -c "cat /config/appsettings.json"
deny	docker exec pi-kavita sh -c 'cat /config/appsettings.json | python3 -c "..."'
deny	docker compose config
deny	docker compose --profile all config
deny	docker inspect pi-nextcloud --format '{{range .Config.Env}}{{println .}}{{end}}'
deny	docker exec pi-vaultwarden sh -c 'env | grep SSO'
deny	docker exec pi-vaultwarden sh -c 'env | grep -iE "^SSO" | sed "s/=.*/=<set>/"'

# --- other secret-bearing reads ---
deny	cat .env
deny	head -20 config/gluetun/gluetun.env
deny	cat config/ntfy/ntfy.env
deny	docker exec pi-nextcloud cat /var/www/html/config/config.php
deny	cat /mnt/usbdrive/authelia-config/secrets/oidc_kavita_secret.txt
deny	sudo grep -o 'x' /mnt/usbdrive/authelia-config/immich-oauth-config.yaml
deny	docker exec pi-nextcloud printenv
deny	printenv

# --- a heredoc fed to a shell IS executed, so its body stays in scope ---
deny	sh <<EOF\ncat .env\nEOF
deny	docker exec pi-kavita sh <<EOF\ncat /config/appsettings.json\nEOF

# --- the command part is still checked when a heredoc is present ---
deny	cat .env > /tmp/x <<EOF\nharmless\nEOF

# --- a heredoc body is DATA: a commit message about secrets is not a read ---
allow	git commit -F - <<EOF\nmentions docker compose config and cat .env\nEOF
allow	git commit -q -F - <<'EOF'\nrefuses cat /config/appsettings.json reads\nEOF
allow	cat > /tmp/doc.md <<EOF\nread .env carefully\nEOF

# --- placeholders, not secrets: reading these is how the renders get read ---
allow	cat .env.dist
allow	cat config/beszel-agent/agent.env.dist
allow	cat config/immich/oauth-config.yaml.template
allow	cat config/authelia/configuration.yml.template

# --- ordinary work the hook must not break ---
allow	docker compose --profile all config --quiet
allow	ls /mnt/usbdrive/authelia-config/secrets
allow	git status --short
allow	grep -n nextcloud compose.yaml
allow	sed -n '1,40p' scripts/nextcloud-oidc-bootstrap.sh
allow	docker exec pi-immich node -e 'console.log(1)'
allow	docker exec pi-nextcloud printenv WEBUI_AUTH_SIGNOUT_REDIRECT_URL
allow	docker ps --format '{{.Names}}'
allow	make lint

# --- documentation is not a secret, even beside one ---
#
# No such file is committed today - config/homepage/SECRETS.md was moved out of
# the directory it documents, because .claude/settings.json denies the Read and
# Edit tools there regardless of what this hook decides. These cases hold the
# Bash half of the rule: a doc under a secrets/ path is readable, and a command
# naming a doc AND a real secret is still refused on the secret.
allow	grep -n compose.yaml config/homepage/secrets/NOTES.md
allow	sed -i 's#compose.yaml#compose/compose-monitoring.yaml#' config/homepage/secrets/NOTES.md
allow	cat /mnt/usbdrive/authelia-config/secrets/NOTES.markdown
deny	cat config/homepage/secrets/NOTES.md config/homepage/secrets/immich.key
deny	cat config/homepage/secrets/prowlarr_api_key

# --- recursive readers name no secret path, so they must exclude them ---
#
# The first case is the 2026-10-01 leak verbatim: a directory operand, and
# agentgateway.env's values in the transcript. The hook cannot tell a file
# operand from a directory without the filesystem, so `-r` on a single file is
# refused too - drop the flag, or add the exclusions.
deny	grep -rn -i "trilium" config/agentgateway/ scripts/agentgateway* compose/compose-ai.yaml 2>/dev/null | head -30
deny	grep -rn environment compose.yaml
deny	grep -R token config
deny	grep --recursive token config
deny	grep -d recurse token config
deny	sudo grep -rl token /etc/pi-web
deny	docker exec pi-forgejo sh -c 'grep -r token /data/gitea/conf'
deny	git status; grep -rn token config
deny	grep -rn token config --exclude='*.env'
deny	grep -rn token config --exclude-dir=secrets
allow	grep -rn token compose --exclude='*.env' --exclude-dir=secrets
allow	grep -rn --exclude=*.env --exclude-dir=secrets token scripts
allow	grep -rn token compose --exclude="*.env" --exclude-dir="secrets" | head
allow	grep -rn token compose --exclude='*.env' --exclude-dir=secrets; echo done
deny	grep -rn token compose --exclude='*.env' --exclude-dir=secrets; cat config/ntfy/ntfy.env
deny	cat .env --exclude='*.env'
deny	grep -rn token data/ --exclude='*.env' --exclude-dir=secrets
deny	grep -rn token /mnt/usbdrive --exclude='*.env' --exclude-dir=secrets
deny	rg token config
allow	rg token compose -g '!*.env' -g '!secrets'
deny	find config -type f -exec grep -l token {} +
deny	find config -type f -exec sh -c 'cat "$1"' _ {} \\;
allow	find compose -type f ! -name '*.env' ! -path '*/secrets/*' -exec grep -l token {} +
deny	find config -type f | xargs grep token
deny	find config -name '*.yml' -print0 | xargs -0 -n 1 cat
allow	git grep -n no-secret-reads
allow	git -C /opt/pi-web grep -n token -- config
allow	git log --oneline | grep -i fix
allow	ls -R config
allow	sort -r /tmp/list.txt
allow	grep -n token compose.yaml | sort -r
allow	cp -r config /tmp/x && grep -n foo compose.yaml

# --- the exclusions must sit in the reader's own command, not beside it ---
#
# From the PR #459 review: matched against the whole line, an unrelated echo
# satisfied the check while the grep itself walked every .env and secrets/ dir.
deny	grep -rn token config/ ; echo "--exclude='*.env' --exclude-dir=secrets"
deny	grep -rn token config/ && echo --exclude='*.env' --exclude-dir=secrets
deny	grep -rn token config/ || echo --exclude='*.env' --exclude-dir=secrets
deny	grep -rn token config/ | echo --exclude='*.env' --exclude-dir=secrets
deny	grep -rn token config/ & echo --exclude='*.env' --exclude-dir=secrets
deny	grep -rn token config/\necho --exclude='*.env' --exclude-dir=secrets
deny	grep -rn token config/ # --exclude='*.env' --exclude-dir=secrets
deny	echo --exclude='*.env' --exclude-dir=secrets; rg token config
deny	find config -type f | xargs grep token --exclude='*.env' --exclude-dir=secrets
allow	find compose -type f ! -name '*.env' ! -path '*/secrets/*' | xargs grep -l token
allow	grep -rn token compose --exclude='*.env' --exclude-dir=secrets 2>&1 | head
allow	cd /opt/pi-web && grep -rn token compose --exclude='*.env' --exclude-dir=secrets
allow	grep -rn '#include' --exclude='*.env' --exclude-dir=secrets src

# --- both exclusions are still not enough over the repository or config/ ---
#
# Those trees also hold the gitignored renders (Backrest's config.json,
# Headscale's and Headplane's config.yaml), which neither exclusion names.
# git grep is the way there; a walk limited to source files passes anywhere.
deny	grep -rn secret config --exclude='*.env' --exclude-dir=secrets
deny	grep -rni key config/ --exclude='*.env' --exclude-dir=secrets
deny	find config -type f ! -name '*.env' ! -path '*/secrets/*' -exec grep -n secret {} +
deny	grep -rn token . --exclude='*.env' --exclude-dir=secrets
deny	grep -rn token /opt/pi-web --exclude='*.env' --exclude-dir=secrets
deny	find config -type f ! -name '*.env' ! -path '*/secrets/*' | xargs grep -l token
deny	cd config/homepage && grep -rn key secrets/ --exclude='*.env' --exclude-dir=secrets
allow	grep -rn fix_ownership --include='*.sh' scripts/
allow	grep -rln run_script --include=*.py .
allow	find docs -name '*.md' -exec grep -l HOST_NAME {} +
allow	find scripts -name '*.sh' | xargs grep -l fix_ownership

# --- the find decides, however many filters stand before xargs ---
deny	find config -type f | grep -v README | xargs grep -n token
deny	find config -type f -print0 | sort -z | xargs -0 grep -n token
deny	find config -type f | head -200 | xargs cat

# --- the git user is not git grep ---
deny	docker exec -u git pi-forgejo grep -n SECRET_KEY /data/gitea/conf/app.ini
deny	docker exec -u git pi-forgejo grep -rn ROOT_URL /data/gitea/conf
deny	docker exec --user git pi-forgejo grep -i secret /data/gitea/conf/app.ini
deny	sudo -u git grep -rn token /opt/pi-web/config
allow	git -C /opt/pi-web --no-pager grep -n token -- compose

# --- `config` is a compose subcommand only right after the global options ---
deny	docker compose -f compose.yaml config
deny	docker compose -f compose.yaml -f /tmp/override.yaml config
deny	docker compose --dry-run config
deny	docker-compose --env-file .env.test config
deny	docker compose config | grep -q services
allow	docker compose -f compose.yaml -f /tmp/override.yaml config --quiet
allow	docker compose exec -T postgres psql -U postgres -d open-webui -tAc "SELECT value FROM config WHERE key = 'x'"
allow	docker compose -f compose.yaml -f /tmp/override.yaml up -d --no-deps agentgateway

# --- key names are what the deny message itself recommends reading ---
allow	grep -oE "^[A-Za-z_]+=" .env
allow	grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' /opt/pi-web/.env
allow	grep -oE '^[A-Za-z_]+=' .env | grep -E 'GEMINI|GROQ'
allow	cd /opt/pi-web && grep -Eo "^[A-Za-z_]+=" .env config/ntfy/ntfy.env
allow	jq -r 'keys[]' config/homepage/secrets/widgets.json
deny	grep -E "^[A-Za-z_]+=" .env
deny	grep -oE "^[A-Za-z_]+=.*" .env
deny	grep -oE "^[A-Za-z_]+=" .env -A3
deny	grep -oE "^[A-Za-z_]+=" .env; cat .env
deny	grep -oE "^[A-Za-z_]+=" .env $(cat .env)
deny	jq -r '.[]' config/homepage/secrets/widgets.json

# --- a single read under the data directory, not only a tree walk ---
#
# The rendered configs and databases there carry secrets with no extension to
# match. A path into the directory is refused; the bare variable name is a
# search pattern. Searching tracked files for a /mnt/ path is git grep's job.
deny	jq . /mnt/usbdrive/backrest/config.json
deny	sqlite3 /mnt/usbdrive/agentgateway/agentgateway.db 'select * from providers'
deny	tail -n 50 data/nextcloud/nextcloud.log
deny	sed -n 1,20p "${DATA_LOCATION:-./data}/backrest/config.json"
deny	grep -n /mnt/usbdrive docs/ARCHITECTURE.md
allow	ls -la /mnt/usbdrive/backrest
allow	df -h /mnt/usbdrive
allow	grep -n DATA_LOCATION compose/compose-ai.yaml
allow	git grep -n /mnt/usbdrive -- docs

# --- the stack's other gitignored renders, and their in-container paths ---
deny	cat config/backrest/config.json
deny	cat config/backrest/config.json.bak.20260901
deny	cat config/headscale/config.yaml
deny	cat config/headplane/config.yaml
deny	cat config/headplane/headscale_api_key
deny	cat config/gluetun/openvpn.ovpn
deny	cat .env.bak.20260901
deny	cat config/n8n/n8n.env.bak.1727
deny	cat .rotate-password.state
deny	docker exec pi-forgejo cat /data/gitea/conf/app.ini
deny	docker exec pi-vaultwarden cat /data/config.json
deny	docker exec pi-traefik cat /letsencrypt/acme.json
deny	docker exec pi-immich cat /proc/1/environ
deny	docker exec pi-immich sh -c 'tr "\\0" "\\n" < /proc/self/environ'
allow	cat config/backrest/config.json.template
allow	cat config/headscale/config.yaml.template
allow	sed -n 1,40p scripts/rotate-password.sh
allow	node -e 'console.log(process.env.HOME)'

# --- line tools print values as surely as cat does ---
deny	diff .env .env.dist
deny	sort .env
deny	cut -d= -f2 config/ntfy/ntfy.env
allow	diff config/beszel-agent/agent.env.dist /tmp/agent.env.dist
allow	sort -u /tmp/list.txt

# --- git grep is exempt only while it searches tracked files ---
deny	git grep --no-index -n token config
deny	git grep --untracked --no-exclude-standard -n token

# --- a heredoc an interpreter executes is code, not data ---
deny	python3 - <<'PY'\nprint(open('.env').read())\nPY
deny	docker exec -i pi-kavita python3 - <<'PY'\nprint(open('/config/appsettings.json').read())\nPY
allow	python3 - <<'PY'\nprint('hello')\nPY
allow	git commit -F - <<'EOF'\npython3 then cat .env, as prose\nEOF

# --- a tab is blank space too: [ \t] in a grep bracket did not match one ---
deny	sh <<-EOF\n\tcat .env\n\tEOF
deny	docker exec pi-kavita sh -c '\tcat /config/appsettings.json'

# --- a heredoc that never closes hides nothing ---
deny	echo "a <<EOF b"\ncat .env
deny	cat <<-EOF\n\tdata\n\tEOF\ncat .env
allow	cat <<-EOF\n\tprose about .env\n\tEOF\necho done

# --- a bare docker inspect prints Config.Env with everything else ---
deny	docker inspect pi-nextcloud
deny	docker inspect pi-nextcloud | head -50
deny	docker container inspect pi-nextcloud
deny	docker inspect pi-nextcloud | jq '.[0].Config'
deny	docker inspect pi-nextcloud | jq '.[0].Config.Env'
allow	docker inspect pi-nextcloud --format '{{json .Mounts}}'
allow	docker inspect -f '{{.State.Health.Status}}' pi-nextcloud
allow	docker inspect pi-nextcloud | jq '.[0].Mounts'
allow	docker inspect pi-nextcloud | jq -r '.[0].Config.Labels'
allow	docker network inspect frontend
deny	docker inspect --format '{{json .Config}}' pi-nextcloud
deny	docker inspect -f '{{json .}}' pi-nextcloud
deny	docker inspect pi-nextcloud --format='{{.Config}}'
deny	docker inspect pi-nextcloud # --format
allow	docker inspect pi-traefik --format '{{json .Config.Labels}}'
allow	docker inspect pi-nextcloud | jq '.[] | .State.Health'
allow	docker inspect pi-nextcloud | jq '.[0] | .State'

# --- the environment, wherever the dump sits in the line ---
deny	env|grep -i token
deny	printenv|grep -i token
deny	docker exec pi-vaultwarden env|grep SSO
deny	docker exec pi-x env 2>&1 | grep -i pass
deny	env; echo done
deny	echo "$(env)"
deny	docker exec pi-x printenv DATABASE_URL
deny	docker exec pi-vaultwarden printenv SSO_CLIENT_SECRET
deny	echo "$GROQ_API_KEY"
allow	echo "${#GROQ_API_KEY}"
allow	[ -n "$GROQ_API_KEY" ] && echo set
allow	env -i PATH=/usr/bin make lint
allow	/usr/bin/env python3 scripts/openclaw-bootstrap.py

# --- stored secrets printed with no file path ---
deny	docker exec -u www-data pi-nextcloud php occ config:list system --private
deny	docker exec pi-redis valkey-cli CONFIG GET requirepass
deny	docker exec pi-redis redis-cli acl list
allow	docker exec -u www-data pi-nextcloud php occ config:list system

# --- the *arr, qBittorrent and changedetection configs, and container data ---
deny	docker exec pi-prowlarr cat /config/config.xml
deny	docker exec pi-prowlarr grep -i apikey /config/config.xml
deny	docker exec pi-backrest cat /userdata/prowlarr/config.xml
deny	docker exec pi-changedetection cat /datastore/url-watches.json
deny	docker exec pi-qbittorrent cat /config/qBittorrent/qBittorrent.conf
deny	docker exec pi-agentgateway cat /data/agentgateway.db
deny	sqlite3 /opt/pi-web/data/agentgateway/agentgateway.db 'select * from providers'
deny	cat "$PWD/data/redis/redis-auth.conf"

# --- a path ends at a redirection, a backtick, a glob or a brace too ---
deny	cat .env>&2
deny	cat .env>/dev/stderr
deny	echo `cat .env`
deny	grep -n PASSWORD .env*
deny	diff .env{.dist,}
deny	cat {.env,README.md}

# --- readers spelled with a path, and the ones the list missed ---
deny	/bin/cat .env
deny	/usr/bin/head -5 config/ntfy/ntfy.env
deny	docker exec pi-kavita /bin/cat /config/appsettings.json
deny	find config -type f -exec /bin/grep -n token {} +
deny	\\cat .env
deny	batcat .env
deny	fgrep PASSWORD .env
deny	zgrep PASSWORD .env
deny	python3.11 -c 'print(open(".env").read())'

# --- the interpreter is the word before <<, wherever it is spelled ---
deny	/usr/bin/python3 - <<'PY'\nprint(open('.env').read())\nPY
deny	.venv/bin/python - <<'PY'\nprint(open('.env').read())\nPY
deny	sh<<EOF\ncat .env\nEOF
deny	docker exec -i pi-kavita bash<<'EOF'\ncat /config/appsettings.json\nEOF
deny	ssh pi@pi.lan <<'EOF'\ncat /opt/pi-web/.env\nEOF
deny	xargs -n1 cat <<EOF\nconfig/ntfy/ntfy.env\nEOF
deny	cat <<'EOF' | python3\nprint(open('.env').read())\nEOF

# --- `cat <<EOF` reads its heredoc, which is how a PR body is passed ---
allow	gh pr create --title "fix(claude-hook): refuse reads of .env backups" --body "$(cat <<'EOF'\n## Summary\n- x\nEOF\n)"
allow	gh pr create --title "fix(authelia): render configuration.yml from the template" --body "$(cat <<'EOF'\n## Summary\nEOF\n)"
allow	gh pr create --title "fix(scripts): data/ ownership after restore" --body "$(cat <<'EOF'\n## Summary\nEOF\n)"
allow	gh pr create --title "feat(sh): run python hooks" --body "$(cat <<'EOF'\nThe hook refuses cat .env now.\nEOF\n)"
deny	cat .env <<EOF\nignored\nEOF

# --- fragments of ordinary text are not secret paths ---
allow	cat ~/.ssh/id_ed25519.pub
allow	jq -r 'to_entries[] | .key' /tmp/labels.json
allow	grep -n credentials compose/compose-monitoring.yaml
allow	cat config/nextcloud/custom.config.php
allow	sed -n 1,20p config/nextcloud/custom.config.php
deny	cat ~/.ssh/id_ed25519
deny	docker exec pi-nextcloud cat /var/www/html/config/config.php
deny	cat ~/.aws/credentials

# --- docker compose config listings print names only ---
allow	docker compose config --services
allow	docker compose --profile all config --profiles
deny	docker compose config # --quiet
deny	docker compose config --format json
